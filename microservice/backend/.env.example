# 本地部署設定。執行 uv run python -m scripts.init_env 會自動複製成 .env 並產生金鑰（.env 不 commit）
# 說明見 microservice/docs/deploy.md

# 用 uv run 啟動後端時連本機 Docker 的資料庫；用 docker compose 啟動後端時會自動改成連 db 容器
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/chiah_ioh_lo

JWT_SECRET=dev-only-change-me-at-least-32-bytes-long
# 加密電話、病史、過敏用；開始存資料後不可更換、不可遺失
FIELD_ENCRYPTION_KEY=
INTERNAL_SECRET=dev-internal-secret

# 前端網址。Android 模擬器連電腦本機要用 10.0.2.2
FRONTEND_BASE_URL=http://10.0.2.2:5173
# 在電腦瀏覽器開前端時的網址（逗號分隔可填多個）
EXTRA_CORS_ORIGINS=http://localhost:5173

# Firebase 服務帳戶金鑰的路徑（放在 secrets/，不 commit）；留空時推播只寫在後端 log
FIREBASE_CREDENTIALS=

# 後端內建排程，每分鐘檢查提醒
SCHEDULER_ENABLED=true
# Demo 期間開啟，才能用 /demo/trigger/* 立即觸發提醒
DEMO_MODE=true
