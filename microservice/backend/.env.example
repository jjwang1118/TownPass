# 本機開發用：複製成 .env 後修改。部署用的是 .env.cloud（見 microservice/docs/deploy.md）
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/chiah_ioh_lo
# 至少 32 字元；產生方式：uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-me-at-least-32-bytes-long
# 產生方式：uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
FIREBASE_CREDENTIALS=
INTERNAL_SECRET=dev-internal-secret
FRONTEND_BASE_URL=http://localhost:5173
EXTRA_CORS_ORIGINS=
REMIND_INTERVAL_MINUTES=10
DEMO_MODE=true
